<androidx.core.widget.NestedScrollView
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:fillViewport="true">
	<LinearLayout
		android:id="@+id/linear15"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:padding="16dp"
		android:orientation="vertical">
		<com.google.android.material.card.MaterialCardView
			android:id="@+id/cardview5"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			app:cardCornerRadius="16dp"
			app:cardElevation="1dp">
			<LinearLayout
				android:id="@+id/linear16"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="16dp"
				android:orientation="vertical">
				<TextView
					android:id="@+id/textview16"
					android:focusable="false"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:text="@string/card_memory_cleanup"
					android:textSize="16sp"
					android:textStyle="bold" />
				<TextView
					android:id="@+id/textview17"
					android:focusable="false"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="4dp"
					android:text="@string/desc_memory_cleanup"
					android:textSize="12sp"
					android:alpha="0.6" />
				<com.google.android.material.button.MaterialButton
					android:id="@+id/btnCleanMemory"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="12dp"
					android:text="@string/btn_clean_memory"
					android:textSize="12sp" />
			</LinearLayout>
		</com.google.android.material.card.MaterialCardView>
		<com.google.android.material.card.MaterialCardView
			android:id="@+id/cardview6"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="16dp"
			app:cardCornerRadius="16dp"
			app:cardElevation="1dp">
			<LinearLayout
				android:id="@+id/linear17"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="16dp"
				android:orientation="vertical">
				<TextView
					android:id="@+id/textview18"
					android:focusable="false"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:text="@string/card_thermal"
					android:textSize="16sp"
					android:textStyle="bold" />
				<TextView
					android:id="@+id/thermalStatusValue"
					android:focusable="false"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="8dp"
					android:text="Unknown"
					android:textSize="20sp" />
			</LinearLayout>
		</com.google.android.material.card.MaterialCardView>
		<com.google.android.material.card.MaterialCardView
			android:id="@+id/cardview7"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="16dp"
			app:cardCornerRadius="16dp"
			app:cardElevation="1dp">
			<LinearLayout
				android:id="@+id/linear18"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="16dp"
				android:orientation="vertical">
				<LinearLayout
					android:id="@+id/linear19"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<TextView
						android:id="@+id/textview19"
						android:focusable="false"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:text="@string/card_recommendations"
						android:textSize="16sp"
						android:textStyle="bold"
						android:layout_weight="1" />
					<com.google.android.material.button.MaterialButton
						android:id="@+id/btnRefreshRecommendations"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="@string/btn_refresh"
						android:textSize="12sp"
						style="@style/Widget.Material3.Button.TextButton" />
				</LinearLayout>
				<androidx.recyclerview.widget.RecyclerView
					android:id="@+id/recommendationsList"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="4dp"
					android:nestedScrollingEnabled="false" />
			</LinearLayout>
		</com.google.android.material.card.MaterialCardView>
		<com.google.android.material.card.MaterialCardView
			android:id="@+id/cardview8"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="16dp"
			app:cardCornerRadius="16dp"
			app:cardElevation="1dp">
			<LinearLayout
				android:id="@+id/linear20"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="16dp"
				android:orientation="vertical">
				<TextView
					android:id="@+id/textview20"
					android:focusable="false"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:text="@string/card_background_apps"
					android:textSize="16sp"
					android:textStyle="bold" />
				<TextView
					android:id="@+id/textview21"
					android:focusable="false"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="4dp"
					android:text="@string/desc_background_apps"
					android:textSize="12sp"
					android:alpha="0.6" />
				<com.google.android.material.button.MaterialButton
					android:id="@+id/btnGrantUsageAccess"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="12dp"
					android:text="@string/btn_grant_usage_access"
					android:textSize="12sp" />
				<androidx.recyclerview.widget.RecyclerView
					android:id="@+id/recentAppsList"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="8dp"
					android:visibility="gone"
					android:nestedScrollingEnabled="false" />
			</LinearLayout>
		</com.google.android.material.card.MaterialCardView>
		<com.google.android.material.card.MaterialCardView
			android:id="@+id/cardview9"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="16dp"
			app:cardCornerRadius="16dp"
			app:cardElevation="1dp">
			<LinearLayout
				android:id="@+id/linear21"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="16dp"
				android:orientation="vertical">
				<TextView
					android:id="@+id/textview22"
					android:focusable="false"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:text="@string/card_game_shortcuts"
					android:textSize="16sp"
					android:textStyle="bold" />
				<TextView
					android:id="@+id/noGamesText"
					android:focusable="false"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="8dp"
					android:text="@string/no_games_found"
					android:textSize="12sp"
					android:alpha="0.6"
					android:visibility="gone" />
				<androidx.recyclerview.widget.RecyclerView
					android:id="@+id/gamesList"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="8dp" />
			</LinearLayout>
		</com.google.android.material.card.MaterialCardView>
	</LinearLayout>
</androidx.core.widget.NestedScrollView>
