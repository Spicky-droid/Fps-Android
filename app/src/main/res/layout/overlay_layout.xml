<com.google.android.material.card.MaterialCardView
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/overlayCard"
	android:layout_width="wrap_content"
	android:layout_height="wrap_content"
	app:cardElevation="6dp"
	app:cardCornerRadius="12dp"
	app:cardBackgroundColor="#D91A1A1A"
	app:strokeWidth="0dp">
	<LinearLayout
		android:id="@+id/linear1"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:padding="8dp"
		android:orientation="vertical"
		android:minWidth="140dp">
		<LinearLayout
			android:id="@+id/linear2"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_vertical"
			android:orientation="horizontal">
			<ImageView
				android:id="@+id/dragHandle"
				android:focusable="false"
				android:layout_width="28dp"
				android:layout_height="28dp"
				android:padding="4dp"
				android:background="@drawable/bg_overlay_handle"
				android:src="@drawable/ic_drag_handle"
				android:scaleType="center"
				android:contentDescription="@null" />
			<View
				android:id="@+id/view3"
				android:layout_width="0dp"
				android:layout_height="1dp"
				android:layout_weight="1" />
			<ImageView
				android:id="@+id/lockToggle"
				android:layout_width="24dp"
				android:layout_height="24dp"
				android:padding="2dp"
				android:background="@drawable/bg_overlay_handle"
				android:src="@drawable/ic_unlock"
				android:scaleType="center"
				android:focusable="true"
				android:contentDescription="@null" />
			<ImageView
				android:id="@+id/closeButton"
				android:layout_width="24dp"
				android:layout_height="24dp"
				android:padding="2dp"
				android:background="@drawable/bg_overlay_handle"
				android:src="@drawable/ic_close"
				android:scaleType="center"
				android:layout_marginStart="4dp"
				android:focusable="true"
				android:contentDescription="@null" />
		</LinearLayout>
		<TextView
			android:id="@+id/fpsValue"
			android:focusable="false"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="2dp"
			android:gravity="center_horizontal|center_vertical"
			android:text="60"
			android:textSize="22sp"
			android:textStyle="bold"
			android:textColor="#00E676" />
		<TextView
			android:id="@+id/fpsLabel"
			android:focusable="false"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_horizontal|center_vertical"
			android:text="FPS"
			android:textSize="10sp"
			android:textColor="#00E676" />
		<LinearLayout
			android:id="@+id/ramRow"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="4dp"
			android:orientation="horizontal">
			<TextView
				android:id="@+id/textview1"
				android:focusable="false"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:text="RAM"
				android:textSize="10sp"
				android:textColor="#00E676"
				android:layout_weight="1" />
			<TextView
				android:id="@+id/ramValue"
				android:focusable="false"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="--"
				android:textSize="10sp"
				android:textColor="#00E676" />
		</LinearLayout>
		<LinearLayout
			android:id="@+id/cpuRow"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal">
			<TextView
				android:id="@+id/textview2"
				android:focusable="false"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:text="CPU"
				android:textSize="10sp"
				android:textColor="#00E676"
				android:layout_weight="1" />
			<TextView
				android:id="@+id/cpuValue"
				android:focusable="false"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="--"
				android:textSize="10sp"
				android:textColor="#00E676" />
		</LinearLayout>
		<LinearLayout
			android:id="@+id/batteryRow"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal">
			<TextView
				android:id="@+id/textview3"
				android:focusable="false"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:text="BATT"
				android:textSize="10sp"
				android:textColor="#00E676"
				android:layout_weight="1" />
			<TextView
				android:id="@+id/batteryValue"
				android:focusable="false"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="--"
				android:textSize="10sp"
				android:textColor="#00E676" />
		</LinearLayout>
		<LinearLayout
			android:id="@+id/tempRow"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal">
			<TextView
				android:id="@+id/textview4"
				android:focusable="false"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:text="TEMP"
				android:textSize="10sp"
				android:textColor="#00E676"
				android:layout_weight="1" />
			<TextView
				android:id="@+id/tempValue"
				android:focusable="false"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="--"
				android:textSize="10sp"
				android:textColor="#00E676" />
		</LinearLayout>
		<LinearLayout
			android:id="@+id/networkRow"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			android:visibility="gone">
			<TextView
				android:id="@+id/textview5"
				android:focusable="false"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:text="NET"
				android:textSize="10sp"
				android:textColor="#00E676"
				android:layout_weight="1" />
			<TextView
				android:id="@+id/networkValue"
				android:focusable="false"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="--"
				android:textSize="10sp"
				android:textColor="#00E676" />
		</LinearLayout>
		<LinearLayout
			android:id="@+id/refreshRateRow"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal">
			<TextView
				android:id="@+id/textview6"
				android:focusable="false"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:text="HZ"
				android:textSize="10sp"
				android:textColor="#00E676"
				android:layout_weight="1" />
			<TextView
				android:id="@+id/refreshRateValue"
				android:focusable="false"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="--"
				android:textSize="10sp"
				android:textColor="#00E676" />
		</LinearLayout>
		<LinearLayout
			android:id="@+id/resolutionRow"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			android:visibility="gone">
			<TextView
				android:id="@+id/textview7"
				android:focusable="false"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:text="RES"
				android:textSize="10sp"
				android:textColor="#00E676"
				android:layout_weight="1" />
			<TextView
				android:id="@+id/resolutionValue"
				android:focusable="false"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="--"
				android:textSize="10sp"
				android:textColor="#00E676" />
		</LinearLayout>
	</LinearLayout>
</com.google.android.material.card.MaterialCardView>
